{
  "appId": "com.baselmoanes.app",
  "appName": "باسل مؤنس",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "baselmoanes.app"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0c1210",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c1210"
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0c1210"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0c1210"
  },
  "appendUserAgent": "Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36"
}